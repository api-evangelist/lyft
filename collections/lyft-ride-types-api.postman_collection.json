        {
          "id": "020cdc81-5f62-4ce1-90a8-7c670dfe681e",
          "name": "List ride types",
          "request": {
            "name": "List ride types",
            "description": {
              "content": "Returns information about what kinds of Lyft rides are available at a given location. The response includes ride type identifiers, display names, pricing details, image URLs, and passenger seat capacity.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ridetypes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<double>",
                  "description": "(Required) Latitude of the location."
                },
                {
                  "disabled": false,
                  "key": "lng",
                  "value": "<double>",
                  "description": "(Required) Longitude of the location."
                },
                {
                  "disabled": false,
                  "key": "ride_type",
                  "value": "<string>",
                  "description": "A specific ride type to filter by. If provided, only the specified ride type is returned."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
