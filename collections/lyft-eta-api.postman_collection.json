                  "disabled": false,
                  "key": "lat",
                  "value": "<double>",
                  "description": "(Required) Latitude of the location."
                },
                {
                  "disabled": false,
                  "key": "lng",
                  "value": "<double>",
                  "description": "(Required) Longitude of the location."
                },
                {
                  "disabled": false,
                  "key": "destination_lat",
                  "value": "<double>",
                  "description": "Latitude of the destination location for improved ETA accuracy."
                },
                {
                  "disabled": false,
                  "key": "destination_lng",
                  "value": "<double>",
                  "description": "Longitude of the destination location for improved ETA accuracy."
                },
                {
                  "disabled": false,
                  "key": "ride_type",
                  "value": "<string>",
                  "description": "A specific ride type to filter ETA results by."
