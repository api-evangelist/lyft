{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lyft Concierge Concierge Rides Profile API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Profile",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get user profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lyft.com/v1/profile"
          },
          "docs": "Returns the authenticated user's profile information including their first name, last name, and whether the profile has been verified."
        }
      ]
    }
  ],
  "bundled": true
}